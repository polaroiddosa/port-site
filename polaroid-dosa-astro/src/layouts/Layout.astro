---
import '../styles/global.css';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Polaroid Dosa is a creative and digital marketing agency in Palakkad, Kerala, working with businesses worldwide on social media, ads, branding, films and websites." />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&display=swap" rel="stylesheet" />
    
    <!-- Preload critical assets -->
    <link rel="preload" as="image" href="/images/robot-mascot.webp" />
    <link rel="preload" as="font" href="/fonts/your-font.woff2" crossorigin />

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Meta for SEO -->
    <meta property="og:title" content="Polaroid Dosa — Creative Agency" />
    <meta property="og:description" content="Polaroid Dosa is a creative and digital marketing agency in Palakkad, Kerala, working with businesses worldwide on social media, ads, branding, films and websites." />
    <meta property="og:image" content="/images/og-image.jpg" />
    <!-- Visitor stats: self-hosted Umami at insights.polaroiddosa.com (cookieless, no personal data). Added 2026-10-22. -->
    <script is:inline defer src="https://insights.polaroiddosa.com/pd.js" data-website-id="a93ed959-b23f-4375-a17a-427550744d3e" data-domains="portfolio.polaroiddosa.com"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
